{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 96,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": {},
  "sortTailwindcss": {
    "stylesheet": "src/app.css"
  },
  "ignorePatterns": [
    "dist/**",
    ".tanstack/**",
    ".nitro/**",
    "src/routeTree.gen.ts",
    "src/app.css",
    "pnpm-lock.yaml"
  ]
}

{
  "name": "pocket-ctf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An offline, browser-based CTF: twelve hand-built puzzles, zero plaintext flags.",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "gen": "node scripts/generate.mjs",
    "gen:sample": "node scripts/generate.mjs --sample",
    "icons": "node scripts/build-icons.mjs",
    "verify:flags": "node scripts/leak-scan.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm verify:flags && pnpm test",
    "postinstall": "node scripts/bootstrap.mjs",
    "predev": "node scripts/bootstrap.mjs",
    "prebuild": "node scripts/bootstrap.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/solid-router": "^1.170.18",
    "@tanstack/solid-start": "^1.168.32",
    "lucide-solid": "^1.27.0",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "tailwindcss": "^4.3.3",
    "terser": "^5.49.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.14",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}

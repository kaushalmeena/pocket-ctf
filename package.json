{
  "name": "pocket-ctf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An offline, browser-based CTF: eleven hand-built puzzles, zero plaintext flags.",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "gen": "node scripts/generate.mjs",
    "selftest": "node scripts/selftest.mjs",
    "verify:flags": "node scripts/verify-no-flags.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm verify:flags && pnpm selftest"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^1.3.2",
    "solid-js": "^1.9.14",
    "vinxi": "^0.5.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}

{
  "name": "pocket-ctf",
  "version": "0.1.0",
  "private": true,
  "description": "A capture-the-flag hunt with no map: the flags are hidden in the site itself.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "gen": "node scripts/generate.mjs",
    "gen:env": "node scripts/env-write.mjs",
    "gen:sample": "node scripts/generate.mjs --sample",
    "icons": "node scripts/build-icons.mjs",
    "verify:flags": "node scripts/leak-scan.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm verify:flags && pnpm test",
    "postinstall": "node scripts/bootstrap.mjs",
    "predev": "node scripts/bootstrap.mjs && node scripts/migrate.mjs",
    "prebuild": "node scripts/bootstrap.mjs && node scripts/migrate.mjs",
    "test": "vitest run",
    "self-test": "node scripts/self-test.mjs",
    "test:watch": "vitest",
    "format:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@tanstack/solid-router": "^1.170.43",
    "@tanstack/solid-start": "^1.169.4",
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.4",
    "lucide-solid": "^1.27.0",
    "nitro": "3.0.261103-rc",
    "pg": "^8.23.1",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tailwindcss": "^1.17.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.49.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}

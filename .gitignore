node_modules
dist
.tanstack
.nitro
*.local
.DS_Store
.env
.env.*

# The plaintext answer key. Never commit this -- everything the site needs is
# derived from it at build time and lands in src/lib/generated/.
flags.secret.json

# Per-deployment flag suffixes, and the resolved answers derived from them.
seeds.secret.json
ANSWERS.secret.md

# This deployment's generated challenge data. Committing it would publish the
# running instance's puzzle payloads and hash material -- a clone could then
# recover working flags without visiting the site. The committed demo set lives
# in src/lib/generated/sample/, and scripts/bootstrap.mjs seeds from it.
src/lib/generated/registry.json
src/lib/generated/payloads.json

# Both name the per-deployment unlisted path or the site URL, so they are
# generated rather than committed.
public/robots.txt
public/sitemap.xml

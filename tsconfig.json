{
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client", "node"],
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // .mjs files are Node-only build tooling -- the generator, the leak scanner,
  // and each challenge's build/solve pair. They are verified by `pnpm test`,
  // which runs every one of them for real, and that catches more than types
  // would. Everything that ships to the browser is .ts/.tsx and is checked,
  // including src/lib/kdf.js.
  "include": ["src", "vite.config.ts"],
  "exclude": ["**/*.mjs"]
}

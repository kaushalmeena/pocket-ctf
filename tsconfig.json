{
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client", "node"],
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // The Node scripts in scripts/ are intentionally out of scope: they are
  // plain .mjs build tooling, and `pnpm selftest` verifies them by actually
  // solving every challenge from their output, which catches more than types
  // would. src/lib/kdf.js *is* checked -- it ships to the browser.
  "include": ["src", "vite.config.ts"]
}
